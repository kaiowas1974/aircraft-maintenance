<%- include('../header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Hangars</h1>
    <a href="/hangars/new" class="btn btn-primary">Add New</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Airport</th>
            <th>Capacity</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        <% hangars.forEach(hangar => { %>
        <tr>
            <td><%= hangar.name %></td>
            <td><%= hangar.airport ? hangar.airport.name : '' %></td>
            <td><%= hangar.capacity || 0 %></td>
                <td class="d-flex gap-2">
                    <a href="/hangars/<%= hangar.id %>/edit" class="btn btn-sm btn-warning">Edit</a>
                    <form action="/hangars/<%= hangar.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure?');">
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
        </tr>
        <% }) %>
    </tbody>
</table>

<%- include('../footer') %>
