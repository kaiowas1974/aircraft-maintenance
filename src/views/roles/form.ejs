<%- include('../header') %>
<h1><%= role ? 'Edit' : 'New' %> Role</h1>

<form action="/roles<%= role ? '/' + role.id : '' %>" method="POST">
    <div class="mb-3">
        <label for="role_name" class="form-label">Role Name</label>
        <input type="text" class="form-control" id="role_name" name="role_name" value="<%= role ? role.role_name : '' %>" required>
    </div>
    <button type="submit" class="btn btn-success">Save</button>
    <a href="/roles" class="btn btn-secondary">Cancel</a>
</form>

<%- include('../footer') %>
