<%- include('../header') %>
<h1><%= hangar ? 'Edit' : 'New' %> Hangar</h1>

<form action="/hangars<%= hangar ? '/' + hangar.id : '' %>" method="POST">
    <div class="mb-3">
        <label for="airport_id" class="form-label">Airport</label>
        <select class="form-select" id="airport_id" name="airport_id" required>
            <option value="">Select an airport</option>
            <% airports.forEach(airport => { %>
                <option value="<%= airport.id %>" <%= hangar && hangar.airport_id === airport.id ? 'selected' : '' %>>
                    <%= airport.name %> (<%= airport.icao %>)
                </option>
            <% }) %>
        </select>
    </div>
    <div class="mb-3">
        <label for="name" class="form-label">Name</label>
        <input type="text" class="form-control" id="name" name="name" value="<%= hangar ? hangar.name : '' %>" required>
    </div>
    <div class="mb-3">
        <label for="capacity" class="form-label">Capacity</label>
        <input type="number" class="form-control" id="capacity" name="capacity" value="<%= hangar ? hangar.capacity : '' %>">
    </div>
    <button type="submit" class="btn btn-success">Save</button>
    <a href="/hangars" class="btn btn-secondary">Cancel</a>
</form>

<%- include('../footer') %>
