<%- include('../header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Aircraft Types</h1>
    <a href="/aircraft-types/new" class="btn btn-primary">Add New</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Manufacturer</th>
            <th>Model</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        <% aircraftTypes.forEach(type => { %>
        <tr>
            <td><%= type.manufacturer %></td>
            <td><%= type.model %></td>
            <td>
                <a href="/aircraft-types/<%= type.id %>/edit" class="btn btn-sm btn-warning">Edit</a>
            </td>
        </tr>
        <% }) %>
    </tbody>
</table>

<%- include('../footer') %>
