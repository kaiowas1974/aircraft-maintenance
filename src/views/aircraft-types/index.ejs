<%- include('../header') %>
<h1>Aircraft Types</h1>

<div class="mb-3">
    <a href="/aircraft-types/new" class="btn btn-success">New Aircraft Type</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Manufacturer</th>
            <th>Model</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        <% aircraftTypes.forEach(type => { %>
        <tr>
            <td><%= type.manufacturer %></td>
            <td><%= type.model %></td>
                <td class="d-flex gap-2">
                    <a href="/aircraft-types/<%= type.id %>/edit" class="btn btn-sm btn-warning">Edit</a>
                    <form action="/aircraft-types/<%= type.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure?');">
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
        </tr>
        <% }) %>
    </tbody>
</table>

<%- include('../footer') %>
