<%- include('../header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Licenses</h1>
    <a href="/licenses/new" class="btn btn-primary">Add New</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>License Type</th>
            <th>Description</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        <% licenses.forEach(license => { %>
        <tr>
            <td><%= license.license_type %></td>
            <td><%= license.description || '' %></td>
            <td class="d-flex gap-2">
                <a href="/licenses/<%= license.id %>/edit" class="btn btn-sm btn-warning">Edit</a>
                <form action="/licenses/<%= license.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure?');">
                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                </form>
            </td>
        </tr>
        <% }) %>
    </tbody>
</table>

<%- include('../footer') %>
