<%- include('../header') %>
<style>
    .booking-container {
        display: flex;
        height: calc(100vh - 120px);
        border: 1px solid #dee2e6;
    }
    .booking-main {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }
    .calendar-header {
        padding: 10px;
        border-bottom: 1px solid #dee2e6;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .calendar-container {
        flex-grow: 1;
        overflow: auto;
    }
    .grid-wrapper {
        position: relative;
        display: inline-block;
    }
    .calendar-grid {
        display: grid;
        grid-template-columns: 250px repeat(24, minmax(60px, 1fr));
        grid-template-rows: 30px repeat(24, 40px);
        width: max-content;
    }
    .grid-header {
        background-color: #e9ecef;
        text-align: center;
        font-size: 0.8rem;
        line-height: 30px;
        border-right: 1px solid #dee2e6;
        border-bottom: 1px solid #dee2e6;
        position: sticky;
        top: 0;
        z-index: 20;
    }
    .aircraft-label {
        background-color: #e9ecef;
        text-align: left;
        padding-left: 10px;
        font-size: 0.85rem;
        font-weight: bold;
        border-right: 1px solid #dee2e6;
        border-bottom: 1px solid #dee2e6;
        position: sticky;
        left: 0;
        z-index: 10;
    }
    .grid-cell {
        border-right: 1px solid #eee;
        border-bottom: 1px solid #eee;
    }
    #events-layer {
        position: absolute;
        top: 0;
        left: 0;
        pointer-events: none;
        z-index: 5;
    }
    .booking-event {
        background-color: rgba(13, 110, 253, 0.7);
        color: white;
        font-size: 0.7rem;
        padding: 2px 5px;
        border-radius: 3px;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
        position: absolute;
    }
</style>

<h1>Bookings</h1>

<div class="booking-container">
    <div class="booking-main">
        <div class="calendar-header">
            <div>
                <button class="btn btn-sm btn-outline-secondary" id="prev-day">&lt;</button>
                <button class="btn btn-sm btn-outline-secondary" id="today-btn">Today</button>
                <button class="btn btn-sm btn-outline-secondary" id="next-day">&gt;</button>
                <span id="current-date-display" class="ms-3 fw-bold"></span>
            </div>
            <div>
                <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#bookingModal">New Booking</button>
            </div>
        </div>

        <div class="calendar-container" id="calendar-container">
            <div class="grid-wrapper" id="grid-wrapper">
                <div id="calendar-grid" class="calendar-grid">
                    <!-- Grid will be generated by JS -->
                </div>
                <div id="events-layer"></div>
            </div>
        </div>
    </div>
</div>

<!-- Booking Modal -->
<div class="modal fade" id="bookingModal" tabindex="-1" aria-labelledby="bookingModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="bookingModalLabel">New Booking</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="booking-form">
            <div class="mb-3">
                <label for="aircraft_id" class="form-label">Aircraft</label>
                <select class="form-select" id="aircraft_id" name="aircraft_id" required>
                    <% vereinsflugzeuge.forEach(ac => { %>
                        <option value="<%= ac.id %>"><%= ac.registration %></option>
                    <% }) %>
                </select>
            </div>
            <div class="mb-3">
                <label for="person_id" class="form-label">Person</label>
                <select class="form-select" id="person_id" name="person_id" required>
                    <% people.forEach(p => { %>
                        <option value="<%= p.id %>"><%= p.first_name %> <%= p.last_name %></option>
                    <% }) %>
                </select>
            </div>
            <div class="mb-3">
                <label for="start_time" class="form-label">Start Time</label>
                <input type="datetime-local" class="form-control" id="start_time" name="start_time" required>
            </div>
            <div class="mb-3">
                <label for="end_time" class="form-label">End Time</label>
                <input type="datetime-local" class="form-control" id="end_time" name="end_time" required>
            </div>
            <div class="mb-3">
                <label for="remarks" class="form-label">Remarks</label>
                <textarea class="form-control" id="remarks" name="remarks"></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Create Booking</button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
    const vereinsflugzeuge = <%- JSON.stringify(vereinsflugzeuge) %>;
    let currentDate = new Date();
    currentDate.setHours(0, 0, 0, 0);

    const grid = document.getElementById('calendar-grid');
    const eventsLayer = document.getElementById('events-layer');
    const dateDisplay = document.getElementById('current-date-display');
    const aircraftSelect = document.getElementById('aircraft_id');

    function initGrid() {
        grid.innerHTML = '';
        
        // Corner cell
        const corner = document.createElement('div');
        corner.className = 'grid-header';
        corner.textContent = '';
        grid.appendChild(corner);

        // Hour headers
        for (let i = 0; i < 24; i++) {
            const header = document.createElement('div');
            header.className = 'grid-header';
            header.textContent = `${i}:00`;
            grid.appendChild(header);
        }

        // Rows for aircraft
        vereinsflugzeuge.forEach(ac => {
            const label = document.createElement('div');
            label.className = 'aircraft-label';
            label.textContent = ac.registration;
            grid.appendChild(label);

            // Hour cells
            for (let hour = 0; hour < 24; hour++) {
                const cell = document.createElement('div');
                cell.className = 'grid-cell';
                grid.appendChild(cell);
            }
        });
    }

    async function fetchBookings() {
        const start = currentDate.toISOString();
        const end = new Date(currentDate.getTime() + 86400000).toISOString();
        
        const response = await fetch(`/api/bookings?start=${start}&end=${end}`);
        const bookings = await response.json();
        
        renderBookings(bookings);
    }

    function renderBookings(bookings) {
        eventsLayer.innerHTML = '';

        bookings.forEach(booking => {
            const start = new Date(booking.start_time);
            const end = new Date(booking.end_time);
            
            if (start.toDateString() !== currentDate.toDateString()) return;

            const aircraftIndex = vereinsflugzeuge.findIndex(ac => ac.id === booking.aircraft.id);
            if (aircraftIndex === -1) return;

            const startHour = start.getUTCHours();
            const startMin = start.getUTCMinutes();
            const durationHours = (end - start) / (1000 * 60 * 60);

            const event = document.createElement('div');
            event.className = 'booking-event';
            event.textContent = `${booking.person.first_name} ${booking.person.last_name}`;
            
            const top = 30 + (aircraftIndex * 40) + (startMin / 60 * 40);
            const left = 250 + (startHour * 60) + (startMin / 60 * 60);
            const width = durationHours * 60;
            const height = 25;

            event.style.top = `${top}px`;
            event.style.left = `${left}px`;
            event.style.width = `${width}px`;
            event.style.height = `${height}px`;

            eventsLayer.appendChild(event);
        });
    }

    function updateDisplay() {
        dateDisplay.textContent = currentDate.toLocaleDateString('de-DE', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
        initGrid();
        fetchBookings();
    }

    document.getElementById('prev-day').addEventListener('click', () => {
        currentDate.setDate(currentDate.getDate() - 1);
        updateDisplay();
    });

    document.getElementById('next-day').addEventListener('click', () => {
        currentDate.setDate(currentDate.getDate() + 1);
        updateDisplay();
    });

    document.getElementById('today-btn').addEventListener('click', () => {
        currentDate = new Date();
        currentDate.setHours(0,0,0,0);
        updateDisplay();
    });

    document.getElementById('booking-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(e.target);
        const data = Object.fromEntries(formData.entries());

        const response = await fetch('/api/bookings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });

        if (response.ok) {
            const modal = bootstrap.Modal.getInstance(document.getElementById('bookingModal'));
            modal.hide();
            e.target.reset();
            updateDisplay();
        } else {
            alert('Error creating booking');
        }
    });

    // Initialize
    updateDisplay();

</script>

<%- include('../footer') %>
