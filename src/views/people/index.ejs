<%- include('../header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>People</h1>
    <a href="/people/new" class="btn btn-primary">Add New</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>License Number</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        <% people.forEach(person => { %>
        <tr>
            <td><%= person.first_name %></td>
            <td><%= person.last_name %></td>
            <td><%= person.email || '' %></td>
            <td><%= person.license_number || '' %></td>
            <td>
                <a href="/people/<%= person.id %>/edit" class="btn btn-sm btn-warning">Edit</a>
            </td>
        </tr>
        <% }) %>
    </tbody>
</table>

<%- include('../footer') %>
