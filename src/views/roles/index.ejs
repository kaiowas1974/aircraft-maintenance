<%- include('../header') %>
<h1>Roles</h1>

<div class="mb-3">
    <a href="/roles/new" class="btn btn-success">New Role</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Role Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        <% roles.forEach(role => { %>
        <tr>
            <td><%= role.role_name %></td>
            <td class="d-flex gap-2">
                <a href="/roles/<%= role.id %>/edit" class="btn btn-sm btn-warning">Edit</a>
                <form action="/roles/<%= role.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure?');">
                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                </form>
            </td>
        </tr>
        <% }) %>
    </tbody>
</table>

<%- include('../footer') %>
