<%- include('../header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Airports</h1>
    <a href="/airports/new" class="btn btn-primary">Add New</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ICAO</th>
            <th>IATA</th>
            <th>Name</th>
            <th>City</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        <% airports.forEach(airport => { %>
        <tr>
            <td><%= airport.icao %></td>
            <td><%= airport.iata %></td>
            <td><%= airport.name %></td>
            <td><%= airport.city %></td>
            <td>
                <a href="/airports/<%= airport.id %>/edit" class="btn btn-sm btn-warning">Edit</a>
            </td>
        </tr>
        <% }) %>
    </tbody>
</table>

<%- include('../footer') %>
