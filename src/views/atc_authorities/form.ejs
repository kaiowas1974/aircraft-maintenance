<%- include('../header') %>
<h1><%= authority ? 'Edit' : 'New' %> ATC Authority</h1>

<form action="/atc-authorities<%= authority ? '/' + authority.id : '' %>" method="POST">
    <div class="mb-3">
        <label for="name" class="form-label">Name</label>
        <input type="text" class="form-control" id="name" name="name" value="<%= authority ? authority.name : '' %>" required>
    </div>
    <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea class="form-control" id="description" name="description"><%= authority ? authority.description : '' %></textarea>
    </div>

    <button type="submit" class="btn btn-success">Save</button>
    <a href="/atc-authorities" class="btn btn-secondary">Cancel</a>
</form>

<%- include('../footer') %>
