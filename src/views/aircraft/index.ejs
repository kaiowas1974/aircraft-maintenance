<%- include('../header') %>
<h1>Aircraft</h1>

<div class="mb-3">
    <a href="/aircraft/new" class="btn btn-success">New Aircraft</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Registration</th>
            <th>Type</th>
            <th>Home Airport</th>
            <th>Hangar</th>
            <th>Status</th>
            <th>Club Aircraft</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        <% aircraft.forEach(ac => { %>
            <tr>
                <td><%= ac.registration %></td>
                <td><%= ac.aircraft_type.manufacturer %> <%= ac.aircraft_type.model %></td>
                <td><%= ac.home_airport ? ac.home_airport.name : '' %></td>
                <td><%= ac.current_hangar ? ac.current_hangar.name : '' %></td>
                <td><%= ac.status %></td>
                <td><%= ac.is_club_aircraft ? 'Yes' : 'No' %></td>
                <td>
                    <a href="/aircraft/<%= ac.id %>/edit" class="btn btn-sm btn-warning">Edit</a>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table>

<%- include('../footer') %>
