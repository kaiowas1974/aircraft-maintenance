<%- include('../header') %>
<h1>Airports</h1>

<div class="mb-3">
    <a href="/airports/new" class="btn btn-success">New Airport</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ICAO</th>
            <th>IATA</th>
            <th>Name</th>
            <th>City</th>
            <th>Runways</th>
            <th>Hangars</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        <% airports.forEach(airport => { %>
        <tr>
            <td><%= airport.icao %></td>
            <td><%= airport.iata %></td>
            <td><%= airport.name %></td>
            <td><%= airport.city %></td>
            <td>
                <ul class="list-unstyled mb-0">
                    <% airport.runways.forEach(runway => { %>
                        <li><%= runway.designator %> (<%= runway.length_meters %>m)</li>
                    <% }) %>
                </ul>
            </td>
            <td>
                <ul class="list-unstyled mb-0">
                    <% airport.hangars.forEach(hangar => { %>
                        <li><%= hangar.name %> (<%= hangar.capacity %>)</li>
                    <% }) %>
                </ul>
            </td>
            <td class="d-flex gap-2">
                <a href="/airports/<%= airport.id %>/edit" class="btn btn-sm btn-warning">Edit</a>
                <form action="/airports/<%= airport.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure?');">
                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                </form>
            </td>
        </tr>
        <% }) %>
    </tbody>
</table>

<%- include('../footer') %>
