<%- include('../header') %>
<h1><%= runway ? 'Edit' : 'New' %> Runway</h1>

<form action="/runways<%= runway ? '/' + runway.id : '' %>" method="POST">
    <div class="mb-3">
        <label for="airport_id" class="form-label">Airport</label>
        <select class="form-select" id="airport_id" name="airport_id" required>
            <% airports.forEach(airport => { %>
                <option value="<%= airport.id %>" <%= (runway && runway.airport_id === airport.id) ? 'selected' : '' %>>
                    <%= airport.name %> (<%= airport.icao %>)
                </option>
            <% }) %>
        </select>
    </div>
    <div class="mb-3">
        <label for="designator" class="form-label">Designator</label>
        <input type="text" class="form-control" id="designator" name="designator" value="<%= runway ? runway.designator : '' %>" required>
    </div>
    <div class="mb-3">
        <label for="length_meters" class="form-label">Length (m)</label>
        <input type="number" class="form-control" id="length_meters" name="length_meters" value="<%= runway && runway.length_meters ? runway.length_meters : '' %>">
    </div>
    <div class="mb-3">
        <label for="surface" class="form-label">Surface</label>
        <input type="text" class="form-control" id="surface" name="surface" value="<%= runway ? runway.surface : '' %>">
    </div>

    <button type="submit" class="btn btn-success">Save</button>
    <a href="/runways" class="btn btn-secondary">Cancel</a>
</form>

<%- include('../footer') %>
